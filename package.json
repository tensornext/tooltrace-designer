{
  "name": "tooltrace-designer",
  "private": true,
  "version": "0.1.0",
  "description": "Open reimplementation of the tooltrace.ai designer: photo -> scaled tool outlines -> foam / Gridfinity inserts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
