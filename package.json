    "three": "^0.186.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
